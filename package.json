{
  "name": "web-disegno",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "app": "npm run build && set ELECTRON_RUN_AS_NODE=&& electron .",
    "app:dev": "set ELECTRON_RUN_AS_NODE=&& set GROTTO_DEV=1&& electron .",
    "dist:win": "npm run build && electron-packager . SulawesiGrotto --platform=win32 --arch=x64 --out=release --overwrite --icon=public/icon.ico --ignore=\"release|test_|gen_\"",
    "dist:mac": "npm run build && electron-packager . SulawesiGrotto --platform=darwin --arch=arm64 --out=release --overwrite --ignore=\"release|test_|gen_\"",
    "dist:mac:x64": "npm run build && electron-packager . SulawesiGrotto --platform=darwin --arch=x64 --out=release --overwrite --ignore=\"release|test_|gen_\"",
    "dist:linux": "npm run build && electron-packager . SulawesiGrotto --platform=linux --arch=x64 --out=release --overwrite --ignore=\"release|test_|gen_\""
  },
  "dependencies": {
    "opentype.js": "^1.3.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "electron": "^44.7.2",
    "electron-packager": "^17.1.2",
    "oxlint": "^1.81.0",
    "vite": "^8.3.0"
  }
}
